{
  "name": "dsh-artifact-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace tools for the official DSH docking surface.",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "slots",
        "locale",
        "connection",
        "sidebarRightTabs",
        "sidebarRight"
      ],
      "platform": "web",
      "main": "./lib/client.js"
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "dsh-icons": "file:../dsh-icons"
  }
}
