node_modules/
# A deployment's filled-in copies, whatever suffix names the environment.
# `.env.example` is the tracked template.
.env
.env.*
!.env.example
# Every installation of CubeEgress generates its own root; none is ours to ship.
sandbox/egress-ca/*.crt

# A deployment's own compose overlay: which of its host's paths the gateway can
# see, which of its own services it puts beside these. The three tracked files
# are the shape every deployment shares; this is the part that is one
# deployment's and would be wrong in anybody else's checkout.
compose.local.yml

# Worktrees the coding harness creates; not part of this project.
.claude/worktrees/

# Built by `npm run build` in that package: derived from src/, and rebuilt
# by the image build. The thing to read is the source.
packages/dsh-artifact-panel/lib/
packages/dsh-artifact-panel/node_modules/

# Anti-detect Chromium tree extracted before an antidetect sandbox build.
# The README placeholder stays; everything else is host-local.
sandbox/browser-engine/**
!sandbox/browser-engine/README
